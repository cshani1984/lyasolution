# Copy to .env (not committed) or set in Render / host dashboard
PORT=3840
API_KEY=your-long-random-secret

# OpenAI — CV builder "Enhance with AI" (POST /api/cv/enhance)
# npm install openai  (already in package.json — run npm install in this folder)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OWNER_WHATSAPP_E164=+972509250384

# Gmail — confirmation email to the person who submitted the form
# Use a Google Account with 2-Step Verification → App passwords
# https://myaccount.google.com/apppasswords
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Optional:
GMAIL_FROM_NAME=Lya Solution
CLIENT_EMAIL_SUBJECT=קיבלנו את הפנייה שלך — Lya Solution

# Production: comma-separated site origins for CORS (x-api-key preflight supported)
# Localhost + lyasolution domains are always allowed in addition to this list.
# CORS_ORIGIN=https://www.lya-solution.com,https://lya-solution.com

# Anti-abuse (optional): defaults are 30 requests / 15 minutes per IP on POST /api/notify-lead
# NOTIFY_MAX_PER_IP=30
# NOTIFY_WINDOW_MS=900000

# Behind Render/nginx: so rate limits use real client IP (default 1)
# TRUST_PROXY_HOPS=1

# WhatsApp session folder — use a persistent disk path in production (e.g. Render)
# WWEBJS_DATA_PATH=/var/whatsapp-data

# --- Twilio WhatsApp (Sandbox or Production) ---
# https://console.twilio.com/
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
# Sandbox example: whatsapp:+14155238886
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Optional: enforce X-Twilio-Signature (set public HTTPS URL Twilio calls)
# TWILIO_VALIDATE_SIGNATURE=1
# TWILIO_WEBHOOK_PUBLIC_URL=https://YOUR_HOST/api/whatsapp/webhook
# Optional: reply via REST instead of TwiML (TWILIO_REPLY_MODE=rest)
# TWILIO_REPLY_MODE=twiml

# SmartCrop — service role for Storage + photos inserts (never expose to browser)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Multi-tenant: each studio is matched by profiles.phone after register/login.
# WhatsApp "To" (business number) or "From" (studio forward / sandbox) → that shop's dashboard.
# Do NOT set a global SMARTCROP_SHOP_PHONE — it would force every order onto one account.

# Clipdrop — Generative Fill / Uncrop (POST /api/photos/generative-fill)
# https://clipdrop.co/apis
CLIPDROP_API_KEY=

# Chromium — required on Render/host without Puppeteer’s downloaded Chrome.
# Dockerfile sets these automatically; on bare Linux set:
# PUPPETEER_SKIP_CHROMIUM_DOWNLOAD=true
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
